=render('shared/processed_and_deleted/show', state: :processed)

- details_attributes = @form.errors.empty? ? {} : { open: 'open' }

- if Pundit.policy(current_user, @application).update?
  details.govuk-details *details_attributes
    summary.govuk-details__summary
      span.govuk-details__summary-text Delete application
    .govuk-details__text
      | You can delete an application if an error was made or proceedings never took place

      = form_for @form, as: :application, url: processed_application_path, method: :put, html: { autocomplete: 'off', class: 'delete-form govuk-!-margin-top-3' } do |f|
        .govuk-form-group
          = f.label :deleted_reasons_list, t('deleted_reasons_list', scope: @form.i18n_scope), class: 'govuk-label', for: 'application_deleted_reasons_list'
          span.govuk-error-message
            = f.label :deleted_reasons_list, @form.errors[:deleted_reasons_list].join(', ').html_safe, class: 'error' if @form.errors[:deleted_reasons_list].present?
          = f.collection_select :deleted_reasons_list, @deleted_reasons, :to_s, :to_s, {}, { class: 'govuk-select' }
        .govuk-form-group
          = f.label :deleted_reason, t('deleted_reason', scope: @form.i18n_scope), class: 'govuk-label', for: 'application_deleted_reason'
          span.govuk-error-message
            = f.label :deleted_reason, @form.errors[:deleted_reason].join(','), class: 'error' if @form.errors[:deleted_reason].present?
          = f.text_field :deleted_reason, class: 'govuk-input'

        = f.submit 'Delete application', :class => 'govuk-button'

- if Pundit.policy(current_user, @application).benefit_evidence? && @application.appeal_allowed?
  - evidence_details_attributes = @evidence_form.errors.empty? ? {} : { open: 'open' }
  details.govuk-details.evidence-received *evidence_details_attributes
    summary.govuk-details__summary
      span.govuk-details__summary-text Evidence Received
    .govuk-details__text
      = form_for @evidence_form, as: :benefit_evidence, url: benefit_evidence_processed_application_path(@application), method: :post, html: { autocomplete: 'off', class: 'evidence-received-form' } do |f|
        .govuk-form-group class=('govuk-form-group--error' if @evidence_form.errors[:evidence].present?)
          fieldset.govuk-fieldset
            legend.govuk-fieldset__legend = t('evidence', scope: @evidence_form.i18n_scope)
            - if @evidence_form.errors[:evidence].present?
              span.govuk-error-message
                = f.label :evidence, @evidence_form.errors[:evidence].join(', '), class: 'error'
            .govuk-radios.govuk-radios--small id='benefit_evidence_evidence'
              .govuk-radios__item
                = f.radio_button :evidence, 'true', class: 'govuk-radios__input'
                = f.label :evidence, t('evidence_true', scope: @evidence_form.i18n_scope), value: 'true', class: 'govuk-label govuk-radios__label'
              .govuk-radios__item
                = f.radio_button :evidence, 'false', class: 'govuk-radios__input'
                = f.label :evidence, t('evidence_false', scope: @evidence_form.i18n_scope), value: 'false', class: 'govuk-label govuk-radios__label'

        = f.submit 'Save and Continue', class: 'govuk-button'

- content_for(:javascripts)
  javascript:
    $(document).ready(function () {
      moj.Modules.GtmTrackTimestamps.processedApplication();
    });
