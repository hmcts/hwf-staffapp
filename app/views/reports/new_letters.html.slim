          user_name: '{AUTO: CURRENT USERS NAME}',
          expiry_date: '{AUTO: DATE EVIDENCE DUE}')
  - if Settings.dwp_api_enabled
    =t('new_letters.evidence.send_evidence.dwp_wages_html', wage_period: '{AUTO: LAST CALENDAR MONTH} {AUTO: LAST THREE MONTHS}')
