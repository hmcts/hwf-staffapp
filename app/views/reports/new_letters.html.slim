  - if Settings.dwp_api_enabled
    =t('new_letters.evidence.send_evidence.dwp_child_maintenance_html')
    =t('new_letters.evidence.send_evidence.dwp_benefits_and_credits_html')
    =t('new_letters.evidence.send_evidence.dwp_rental_html')
    =t('new_letters.evidence.send_evidence.dwp_goods_selling_html')
    =t('new_letters.evidence.send_evidence.dwp_other_monthly_income_html')
    =t('new_letters.evidence.send_evidence.dwp_cash_gifts_and_prizes_html')
    =t('new_letters.evidence.send_evidence.dwp_prisoner_income_html', reference: '{AUTO: APPLICATION REFERENCE}')
  -else
    =t('new_letters.evidence.send_evidence.child_maintenance_html')
    =t('new_letters.evidence.send_evidence.benefits_and_credits_html')
    =t('new_letters.evidence.send_evidence.rental_html')
    =t('new_letters.evidence.send_evidence.goods_selling_html')
