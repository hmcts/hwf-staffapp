= render("shared/application_summary", show_links: false)
= render("shared/result")

- if @application_view.state == 'waiting_for_evidence'
  #result.callout class="callout-evidence_check"
    h2.govuk-heading-l = t("remissions.callout_html")
- elsif @application_view.state == 'waiting_for_part_payment'
  #result.callout class="callout callout-part"
    h2.govuk-heading-l = t("remissions.part_html", amount_to_pay:  @application_view.amount_to_pay)

= render(partial: 'shared/processed_summary', locals: { source: @processing_details })

- content_for(:javascripts)
  javascript:
    $(document).ready(function () {
      moj.Modules.GtmTrackTimestamps.evidence();
    });
